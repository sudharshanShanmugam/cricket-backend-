# MongoDB connection string (local, or MongoDB Atlas for hosting)
MONGODB_URI=mongodb://127.0.0.1:27017/trident_cricket

# Scorer login
ADMIN_ID=scorer
ADMIN_PASSWORD=change-this-password

# Any long random string. Generate with:  openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# Frontend URL(s), comma separated. "*" is fine for local development.
CLIENT_ORIGIN=http://localhost:5180

PORT=5080
# How long the scorer stays logged in
TOKEN_TTL=12h
